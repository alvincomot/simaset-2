// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "mysql"
}

enum Role {
  SUPER_ADMIN
  STAFF
  USER
}

enum KondisiAset {
  BAIK
  RUSAK
}

enum StatusKetersediaan {
  TERSEDIA
  DIPINJAM
  PEMELIHARAAN
  DIALOKASIKAN
}

enum JenisKejadian {
  ALOKASI
  RELOKASI
  MASUK_SERVIS
  SELESAI_SERVIS
}

model user {
  id               Int                  @id @default(autoincrement())
  nim              String               @unique @db.VarChar(20)
  namaLengkap      String               @db.VarChar(100)
  password         String               @db.VarChar(255)
  role             Role                 @default(USER)
  createdAt        DateTime             @default(now())
  resetToken       String?              @db.VarChar(255)
  resetTokenExpiry DateTime?
  isVerified       Boolean              @default(true)
  verificationToken String?             @db.VarChar(255)
  verificationTokenExpiry DateTime?
  
  // Relasi
  borrowings         borrowing[]
  allocationHistories allocation_history[]
}

model category {
  id           Int         @id @default(autoincrement())
  namaKategori String      @db.VarChar(50)
  deskripsi    String?     @db.Text
  createdAt    DateTime    @default(now())
  
  // Relasi
  assets       asset[]
}

model location {
  id                     Int                  @id @default(autoincrement())
  namaLokasi             String               @db.VarChar(50)
  deskripsi              String?              @db.Text
  createdAt              DateTime             @default(now())
  
  // Relasi
  assets                 asset[]              @relation("AssetActualLocation")
  allocatedAssets        asset[]              @relation("AssetAllocatedLocation")
  historyAsalLocations   allocation_history[] @relation("HistoryLokasiAsal")
  historyTujuanLocations allocation_history[] @relation("HistoryLokasiTujuan")
  borrowings             borrowing[]          @relation("BorrowingLocation")
}

model asset {
  id                 Int                @id @default(autoincrement())
  kodeAset           String             @unique @db.VarChar(50)
  namaAset           String             @db.VarChar(150)
  categoryId         Int
  locationId         Int
  lokasiAlokasiId    Int?
  kondisi            KondisiAset        @default(BAIK)
  statusKetersediaan StatusKetersediaan @default(TERSEDIA)
  createdAt          DateTime           @default(now())

  // Definisi Foreign Key
  category           category           @relation(fields: [categoryId], references: [id])
  location           location           @relation("AssetActualLocation", fields: [locationId], references: [id])
  lokasiAlokasi      location?          @relation("AssetAllocatedLocation", fields: [lokasiAlokasiId], references: [id])
  borrowings         borrowing[]
  allocationHistories allocation_history[]
}

model borrowing {
  id                 Int         @id @default(autoincrement())
  userId             Int
  assetId            Int
  lokasiPenggunaanId Int?
  tanggalPinjam      DateTime
  tenggatWaktu       DateTime
  tanggalKembali     DateTime?
  statusPeminjaman   String      @default("PENDING")
  kondisiKembali     KondisiAset?
  catatan            String?     @db.Text
  createdAt          DateTime    @default(now())

  // Definisi Foreign Key
  user               user        @relation(fields: [userId], references: [id])
  asset              asset       @relation(fields: [assetId], references: [id])
  lokasiPenggunaan   location?   @relation("BorrowingLocation", fields: [lokasiPenggunaanId], references: [id], onDelete: SetNull)
}

model allocation_history {
  id             Int           @id @default(autoincrement())
  assetId        Int
  userId         Int
  jenisKejadian  JenisKejadian
  lokasiAsalId   Int?
  lokasiTujuanId Int?
  catatan        String?       @db.Text
  createdAt      DateTime      @default(now())

  // Relasi
  asset          asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user           user          @relation(fields: [userId], references: [id])
  lokasiAsal     location?     @relation("HistoryLokasiAsal", fields: [lokasiAsalId], references: [id])
  lokasiTujuan   location?     @relation("HistoryLokasiTujuan", fields: [lokasiTujuanId], references: [id])
}